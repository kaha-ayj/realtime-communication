# Salin file ini menjadi server/.env lalu isi nilainya.
MIOMIPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
WEBHOOK_PORT=4100

# Opsional: kirim webhook dari mock server ke receiver lokal.
# MIOMIPAY_WEBHOOK_URL=http://localhost:4100/miomipay/webhook

# API key yang diterima mock server (bukan key MiomiPay asli).
MIOMIPAY_API_KEY=miomipay_sandbox_key
